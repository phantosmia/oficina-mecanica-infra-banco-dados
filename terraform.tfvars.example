project_name = "oficina-mecanica-fiap"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr = "10.90.0.0/24"

# CIDRs autorizados a alcançar o RDS na porta 5432. Inclui, por padrão, o
# próprio CIDR desta VPC (vpc_cidr acima): a Lambda de autenticação via CPF
# (oficina-mecanica-lambda-auth) roda dentro desta VPC para alcançar o RDS
# (ver ADR-0005 em oficina-mecanica-fiap) — sem essa entrada, a conexão dela
# falha por timeout, não por erro de credencial. O segundo CIDR é o da VPC
# do EKS (oficina-mecanica-infra-kubernetes, var.vpc_cidr de lá) — os pods
# da aplicação principal também precisam alcançar o RDS. A rota entre as
# duas VPCs (VPC Peering) é criada automaticamente por aquele repositório;
# esta liberação no security group continua manual de propósito.
allowed_cidr_blocks = ["10.90.0.0/24", "10.0.0.0/16"]

rds_instance_class       = "db.t4g.micro"
rds_allocated_storage    = 20
rds_max_allocated_storage = 100
rds_engine_version       = "16.14"
rds_database_name        = "oficina_mecanica"
rds_username             = "oficina"
rds_backup_retention_period = 7
rds_deletion_protection     = false
rds_skip_final_snapshot     = true
